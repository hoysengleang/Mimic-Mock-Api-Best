# Copy this file to .env and edit as needed. Every value has a sensible
# default, so an empty .env works fine.
#
#   cp .env.example .env

# === PORTS ===
# Where the app is reachable on your machine.
API_PORT=5000
UI_PORT=3000

# === APPLICATION ===
APP_NAME=Mimic
API_PREFIX=/api
DEBUG=false

# Writes a working example (mocks, a collection, an environment) on first run
# so a new install is not an empty screen. Never overwrites existing data.
SEED_DEMO_DATA=true

# === SECURITY ===
# Mimic sends HTTP requests on your behalf, from the server.
#
# Leave this true when running Mimic on your own machine — your dev API lives
# on localhost, and Mimic has to be able to reach it.
#
# Set it to false when hosting Mimic somewhere other people can reach, so it
# cannot be used to probe your internal network. Cloud metadata endpoints
# (169.254.169.254) are blocked in BOTH modes, always.
ALLOW_PRIVATE_NETWORK=true

# Extra hostnames to refuse, comma separated. Subdomains are covered too.
# BLOCKED_HOSTS=internal.example.com,admin.example.com

# Per-IP rate limits. These mostly protect you from your own mistakes,
# such as a 10,000-iteration loop pointed at a production API.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=240/minute
RATE_LIMIT_SEND=60/minute
RATE_LIMIT_RUN=12/minute

# Browser origins allowed to call the API. Comma separated.
# Not used in the production compose setup, where UI and API are same-origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === LIMITS ===
EXECUTOR_TIMEOUT_SECONDS=30
EXECUTOR_MAX_REDIRECTS=5
EXECUTOR_MAX_RESPONSE_BYTES=10485760
MAX_REQUEST_BODY_BYTES=10485760

RUNNER_MAX_ITERATIONS=100
RUNNER_MAX_REQUESTS_PER_RUN=2000

HISTORY_MAX_ENTRIES=1000

# === STORAGE ===
# A SQLite file inside DATA_DIR by default. Point DATABASE_URL at PostgreSQL
# if you ever outgrow it.
DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/mimic
